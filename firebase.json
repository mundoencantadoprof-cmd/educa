{
  "hosting": {
    "public": "_site",
    "ignore": ["**/.*"],
    "trailingSlash": true,
    "headers": [
      { "source": "**/*.@(webp|png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
